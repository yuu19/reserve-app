{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reserve-app-web",
	"compatibility_date": "2026-02-04",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Replace with actual backend worker URL.
	"vars": {
		"PUBLIC_BACKEND_URL": "https://api.wakureserve.com",
		"PUBLIC_AI_CHAT_ENABLED": "true",
		"PUBLIC_EVENTS_ORG_SLUG": "public-events",
		"PUBLIC_EVENTS_CLASSROOM_SLUG": "public-events"
	},
	"routes": [
		{
			"pattern": "web.wakureserve.com",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}

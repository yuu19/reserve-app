flowchart TB
  web["1. Webチャット<br/>入力・送信状態・feedback"]
  core["2. 共通contract<br/>saas-chatbot-core"]
  route["3. Backend AI feature<br/>認証・scope・利用回数"]
  search["4. Knowledge infra<br/>D1本文取得・Vectorize検索"]
  provider["5. AI provider<br/>AI Gateway + Workers AI"]
  answer["6. 回答整形<br/>根拠・残利用回数・案内"]
  ui["7. UI表示<br/>古い応答を無視・再送可能"]
  store[("D1<br/>ナレッジ本文<br/>会話<br/>feedback<br/>usage counter")]
  vector[("Vectorize<br/>検索index")]

  web --> core --> route
  route --> store
  route --> search
  search --> store
  search --> vector
  search --> provider
  provider --> answer
  answer --> store
  answer --> ui
  ui --> web

  route -. "organization / classroom scope" .-> search
  answer -. "open_page hrefなしはリンク化しない" .-> ui
